# Supabase — Hosted Project Credentials
#
# Copy this file to `.env.local` and fill in your real values from
# https://supabase.com/dashboard/project/<your-project>/settings/api
#
# Only the public anon key belongs in this file — never put service_role
# keys here. They would ship to every user who installs the extension.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
